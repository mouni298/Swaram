# Copy to .env and fill in. Never commit the real .env.

# --- Twilio (https://console.twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# The Twilio number calls are placed FROM (E.164).
TWILIO_NUMBER=+1xxxxxxxxxx

# --- LLM (Groq) ---
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=llama-3.1-8b-instant

# --- Public URL Twilio reaches us on ---
# Leave blank to auto-detect a running `ngrok http 5005` tunnel, or set explicitly,
# e.g. https://your-subdomain.ngrok.app  (no trailing slash).
PUBLIC_URL=

# --- Server ---
PORT=5005
# Shared secret the browser panel must send with POST /call (set the same value
# in the panel). Leave blank to disable the check (local only).
CALL_SECRET=
# Hard cap on call length (seconds) to bound cost.
MAX_CALL_SECONDS=300
# ConversationRelay TTS voice (depends on ttsProvider; blank = provider default).
CR_VOICE=
# Set to 1 only to validate X-Twilio-Signature on webhooks (needs a stable PUBLIC_URL).
VALIDATE_TWILIO_SIGNATURE=0
# Set to 1 ONLY for the no-phone simulator (simulate-relay.mjs). Never in prod.
ALLOW_SIM=0
