{
  "name": "swaram-ai",
  "version": "0.1.0",
  "private": true,
  "description": "A from-scratch TypeScript SDK for building domain-agnostic voice support agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ricky0123/vad-web": "0.0.29",
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "dotenv": "^17.4.2",
    "twilio": "^6.0.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@types/node": "22.10.1",
    "eslint": "9.16.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vitest": "2.1.8"
  }
}
