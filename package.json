{
  "name": "swaram-ai",
  "version": "0.1.0",
  "description": "A from-scratch TypeScript SDK for building domain-agnostic voice support agents.",
  "license": "MIT",
  "author": "Mounika Grandhi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mouni298/Swaram.git"
  },
  "homepage": "https://github.com/mouni298/Swaram#readme",
  "bugs": {
    "url": "https://github.com/mouni298/Swaram/issues"
  },
  "keywords": [
    "voice",
    "voice-agent",
    "ai",
    "speech-to-text",
    "text-to-speech",
    "llm",
    "tts",
    "stt",
    "agent",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ricky0123/vad-web": "0.0.29",
    "@sapphi-red/web-noise-suppressor": "^0.3.5"
  },
  "peerDependencies": {
    "twilio": "^6.0.2",
    "ws": "^8.21.0"
  },
  "peerDependenciesMeta": {
    "twilio": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@types/node": "22.10.1",
    "dotenv": "^17.4.2",
    "eslint": "9.16.0",
    "twilio": "^6.0.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vitest": "2.1.8",
    "ws": "^8.21.0"
  }
}
